<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="stock_sim_trading.StockSimBoard" owl="1">
        <div class="o_stock_sim_board">
            <div t-if="state.loading" class="o_stock_sim_loading">
                <i class="fa fa-spinner fa-spin"/> 加载中…
            </div>

            <div t-else="" class="o_stock_sim_content">
                <!-- 标的 + 日期 -->
                <div class="o_stock_sim_header">
                    <div class="o_stock_sim_symbol">
                        <span class="o_name" t-esc="board.symbol_name"/>
                        <span class="o_code" t-esc="board.symbol_code"/>
                    </div>
                    <div class="o_stock_sim_date">
                        <span class="o_date" t-esc="board.current_date"/>
                        <span class="o_day">第 <t t-esc="board.days_count + 1"/> 个交易日</span>
                    </div>
                </div>

                <!-- 图表 + 持仓/操作 -->
                <div class="o_stock_sim_main">
                    <div class="o_stock_sim_chart">
                        <div class="o_kline_price_wrap">
                            <canvas t-ref="priceCanvas"/>
                        </div>
                        <div class="o_kline_volume_wrap">
                            <canvas t-ref="volumeCanvas"/>
                        </div>
                    </div>

                    <div class="o_stock_sim_side">
                        <!-- 持仓情况 -->
                        <div class="o_stock_sim_stats">
                            <div class="o_stat o_stat_total">
                                <span class="o_label">总资产</span>
                                <span class="o_value" t-esc="fmtMoney(board.total_assets)"/>
                            </div>
                            <div class="o_stat" t-att-class="pnlClass">
                                <span class="o_label">累计盈亏</span>
                                <span class="o_value">
                                    <t t-esc="fmtMoney(board.total_pnl)"/>
                                    (<t t-esc="fmtPct(board.total_pnl_pct)"/>)
                                </span>
                            </div>
                            <div class="o_stat_row">
                                <div class="o_stat">
                                    <span class="o_label">现金</span>
                                    <span class="o_value" t-esc="fmtMoney(board.cash)"/>
                                </div>
                                <div class="o_stat">
                                    <span class="o_label">持仓市值</span>
                                    <span class="o_value" t-esc="fmtMoney(board.position_value)"/>
                                </div>
                            </div>
                            <div class="o_stat_row">
                                <div class="o_stat">
                                    <span class="o_label">持股</span>
                                    <span class="o_value" t-esc="board.shares"/>
                                </div>
                                <div class="o_stat">
                                    <span class="o_label">持仓均价</span>
                                    <span class="o_value" t-esc="fmtMoney(board.avg_cost)"/>
                                </div>
                            </div>
                            <div class="o_stat">
                                <span class="o_label">当日收盘</span>
                                <span class="o_value" t-esc="fmtMoney(board.close_price)"/>
                            </div>
                        </div>

                        <!-- 仓位比例 -->
                        <div class="o_stock_sim_ratio">
                            <div class="o_ratio_label">
                                仓位比例：<b t-esc="state.ratio"/>%
                            </div>
                            <div class="o_ratio_quick">
                                <button t-on-click="() => this.setRatio(25)" t-att-disabled="state.busy">25%</button>
                                <button t-on-click="() => this.setRatio(50)" t-att-disabled="state.busy">50%</button>
                                <button t-on-click="() => this.setRatio(75)" t-att-disabled="state.busy">75%</button>
                                <button t-on-click="() => this.setRatio(100)" t-att-disabled="state.busy">100%</button>
                            </div>
                            <div class="o_ratio_hint">
                                <span>买入：
                                    <t t-if="buyEstimate.shares">
                                        <b t-esc="buyEstimate.shares"/> 股 / <b t-esc="buyEstimate.lots"/> 手
                                    </t>
                                    <t t-else="">不足 1 手</t>
                                </span>
                                <span>卖出：<b t-esc="sellSharesEstimate"/> 股</span>
                            </div>
                        </div>

                        <!-- 操作 -->
                        <div class="o_action_buttons">
                            <button type="button" class="btn btn-primary o_btn_buy"
                                    t-on-click="onBuy" t-att-disabled="state.busy">
                                <i class="fa fa-arrow-up"/> 买入
                            </button>
                            <button type="button" class="btn btn-danger o_btn_sell"
                                    t-on-click="onSell" t-att-disabled="state.busy">
                                <i class="fa fa-arrow-down"/> 卖出
                            </button>
                            <button type="button" class="btn btn-secondary o_btn_next"
                                    t-on-click="onNext"
                                    t-att-disabled="state.busy or board.is_last_day">
                                <i class="fa fa-step-forward"/> 下一日
                            </button>
                            <button type="button" class="btn btn-default o_btn_finish"
                                    t-on-click="onFinish" t-att-disabled="state.busy">
                                <i class="fa fa-flag-checkered"/> 结束模拟
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 交易记录 -->
                <div class="o_stock_sim_trades">
                    <div class="o_trades_title">交易记录（<t t-esc="board.trade_count"/>）</div>
                    <div t-if="!board.trades.length" class="o_trades_empty">
                        暂无交易
                    </div>
                    <table t-else="" class="o_trades_table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>日期</th>
                                <th>方向</th>
                                <th>价格</th>
                                <th>比例</th>
                                <th>股数</th>
                                <th>金额</th>
                                <th>费用</th>
                                <th>总市值</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="board.trades" t-as="t" t-key="t.sequence"
                                t-att-class="t.side === 'buy' ? 'o_row_buy' : 'o_row_sell'">
                                <td t-esc="t.sequence"/>
                                <td t-esc="t.date"/>
                                <td>
                                    <span class="o_badge" t-att-class="t.side === 'buy' ? 'o_buy' : 'o_sell'"
                                          t-esc="sideLabel(t.side)"/>
                                </td>
                                <td t-esc="fmtMoney(t.price)"/>
                                <td t-esc="t.ratio + '%'"/>
                                <td t-esc="t.shares"/>
                                <td t-esc="fmtMoney(t.gross_amount)"/>
                                <td t-esc="fmtMoney(t.total_fee)"/>
                                <td t-esc="fmtMoney(t.total_assets_after)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
