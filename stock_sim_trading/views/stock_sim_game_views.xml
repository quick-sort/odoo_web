<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Form View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_stock_sim_game_form" model="ir.ui.view">
        <field name="name">stock.sim.game.form</field>
        <field name="model">stock.sim.game</field>
        <field name="arch" type="xml">
            <form string="模拟交易">
                <header>
                    <button name="action_start" string="开始模拟" type="object"
                            class="btn-primary oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_reset" string="重新开始" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,finished"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="名称"/>
                        <h1><field name="name" placeholder="例如：2024 盲盒训练"/></h1>
                    </div>

                    <!-- 隐藏字段：供组件 / 计算使用 -->
                    <field name="symbol_id" invisible="1"/>
                    <field name="start_index" invisible="1"/>
                    <field name="current_index" invisible="1"/>

                    <!-- ── 草稿：模拟配置 ── -->
                    <group string="模拟配置" invisible="state != 'draft'">
                        <group>
                            <field name="starting_capital"/>
                            <field name="trade_lot"/>
                        </group>
                        <group>
                            <field name="commission_rate"/>
                            <field name="min_commission"/>
                            <field name="stamp_duty_rate"/>
                            <field name="transfer_fee_rate"/>
                        </group>
                    </group>
                    <group string="标的范围（随机抽取其一）" invisible="state != 'draft'">
                        <field name="symbol_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="market"/>
                                <field name="bar_count" string="K 线根数"/>
                            </list>
                        </field>
                    </group>
                    <group invisible="state != 'draft'">
                        <div class="o_form_hint Alert Alert-info" role="alert" colspan="2">
                            点击「开始模拟」后，系统将从标的范围内随机抽取一支、并随机选择历史起始日。
                            行情仅显示到当日，逐日推进，只能按当日收盘价交易。
                        </div>
                    </group>

                    <!-- ── 进行中：交易面板 ── -->
                    <group string="交易面板" invisible="state != 'running'">
                        <field name="account_curve" widget="stock_sim_board"
                               nolabel="1" colspan="2"/>
                    </group>

                    <!-- ── 已结束：结果对比 ── -->
                    <group string="结果对比" invisible="state != 'finished'">
                        <field name="benchmark_curve" widget="stock_sim_result_chart"
                               nolabel="1" colspan="2"/>
                    </group>

                    <!-- ── 交易记录（已结束可见；进行中见面板内列表）── -->
                    <notebook invisible="state != 'finished'">
                        <page string="交易记录">
                            <field name="trade_ids">
                                <list>
                                    <field name="sequence" string="序号"/>
                                    <field name="date"/>
                                    <field name="side"/>
                                    <field name="price"/>
                                    <field name="ratio"/>
                                    <field name="shares"/>
                                    <field name="gross_amount"/>
                                    <field name="total_fee"/>
                                    <field name="total_assets_after" string="成交后总市值"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         List View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_stock_sim_game_list" model="ir.ui.view">
        <field name="name">stock.sim.game.list</field>
        <field name="model">stock.sim.game</field>
        <field name="arch" type="xml">
            <list string="模拟交易">
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'running'"
                       decoration-muted="state == 'finished'"/>
                <field name="symbol_id"/>
                <field name="starting_capital"/>
                <field name="total_assets" widget="monetary"/>
                <field name="total_pnl_pct" string="盈亏率(%)"/>
                <field name="trade_count" string="交易笔数"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Search View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_stock_sim_game_search" model="ir.ui.view">
        <field name="name">stock.sim.game.search</field>
        <field name="model">stock.sim.game</field>
        <field name="arch" type="xml">
            <search string="搜索模拟交易">
                <field name="name"/>
                <field name="symbol_id"/>
                <filter name="filter_draft" string="草稿"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_running" string="进行中"
                        domain="[('state','=','running')]"/>
                <filter name="filter_finished" string="已结束"
                        domain="[('state','=','finished')]"/>
                <group expand="0" string="分组">
                    <filter name="group_state" string="状态"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Action + 菜单
    ══════════════════════════════════════════════════════════════════ -->
    <record id="action_stock_sim_game" model="ir.actions.act_window">
        <field name="name">模拟交易</field>
        <field name="res_model">stock.sim.game</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stock_sim_game_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                新建一局模拟交易
            </p>
            <p>
                设定起始资金、交易税费与标的范围，开始后系统随机抽取一支标的与历史起始日，
                逐日按收盘价交易，结束后对比账户市值曲线与买入持有基准。
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_sim_root"
              name="模拟交易"
              sequence="90"/>

    <menuitem id="menu_stock_sim_game"
              name="模拟训练"
              parent="menu_stock_sim_root"
              action="action_stock_sim_game"
              sequence="10"/>

</odoo>
