<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Trade List View
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_stock_sim_trade_list" model="ir.ui.view">
        <field name="name">stock.sim.trade.list</field>
        <field name="model">stock.sim.trade</field>
        <field name="arch" type="xml">
            <list string="交易记录">
                <field name="sequence" string="序号"/>
                <field name="game_id"/>
                <field name="date"/>
                <field name="side" widget="badge"
                       decoration-success="side == 'buy'"
                       decoration-danger="side == 'sell'"/>
                <field name="price"/>
                <field name="ratio"/>
                <field name="shares"/>
                <field name="gross_amount" sum="成交金额合计"/>
                <field name="commission" sum="佣金合计"/>
                <field name="stamp_duty" sum="印花税合计"/>
                <field name="transfer_fee" sum="过户费合计"/>
                <field name="total_fee" sum="费用合计"/>
                <field name="net_amount"/>
                <field name="total_assets_after" string="成交后总市值"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Trade Form View (read-only)
    ══════════════════════════════════════════════════════════════════ -->
    <record id="view_stock_sim_trade_form" model="ir.ui.view">
        <field name="name">stock.sim.trade.form</field>
        <field name="model">stock.sim.trade</field>
        <field name="arch" type="xml">
            <form string="交易记录" edit="0" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="game_id"/>
                            <field name="sequence"/>
                            <field name="date"/>
                            <field name="bar_index"/>
                        </group>
                        <group>
                            <field name="side" widget="badge"
                                   decoration-success="side == 'buy'"
                                   decoration-danger="side == 'sell'"/>
                            <field name="price"/>
                            <field name="ratio"/>
                            <field name="shares"/>
                        </group>
                    </group>
                    <group string="成交金额与费用">
                        <group>
                            <field name="gross_amount"/>
                            <field name="commission"/>
                            <field name="stamp_duty"/>
                            <field name="transfer_fee"/>
                            <field name="total_fee"/>
                            <field name="net_amount"/>
                        </group>
                    </group>
                    <group string="成交后账户快照">
                        <group>
                            <field name="cash_after"/>
                            <field name="shares_after"/>
                            <field name="avg_cost_after"/>
                            <field name="position_value_after"/>
                            <field name="total_assets_after"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Action + 菜单
    ══════════════════════════════════════════════════════════════════ -->
    <record id="action_stock_sim_trade" model="ir.actions.act_window">
        <field name="name">交易记录</field>
        <field name="res_model">stock.sim.trade</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_sim_trade"
              name="交易记录"
              parent="menu_stock_sim_root"
              action="action_stock_sim_trade"
              sequence="20"/>

</odoo>
