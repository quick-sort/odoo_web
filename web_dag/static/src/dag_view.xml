<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Top-level View with Layout (provides search bar, control panel) -->
    <t t-name="web_dag.DagView" owl="1">
        <Layout viewType="'dag'" display="props.display">
            <t t-set-slot="layout-buttons">
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.env.controller.refresh()">
                    <i class="fa fa-refresh"/> Refresh
                </button>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.env.controller.fitToScreen()">
                    <i class="fa fa-arrows-alt"/> Fit
                </button>
            </t>
            <DagController t-props="getControllerProps()" />
        </Layout>
    </t>

    <!-- Controller: manages data loading and orchestrates the renderer -->
    <t t-name="web_dag.DagController" owl="1">
        <div class="o_dag_view h-100 d-flex flex-column">
            <!-- Toolbar -->
            <div class="o_dag_toolbar border-bottom p-2 bg-view d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.refresh()" title="Refresh">
                    <i class="fa fa-refresh"/>
                </button>
                <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.fitToScreen()" title="Fit to screen">
                    <i class="fa fa-arrows-alt"/>
                </button>
                <span class="text-muted small ms-auto">
                    <t t-esc="state.records.length"/> records
                </span>
            </div>

            <!-- Graph area -->
            <div class="o_dag_renderer_wrapper flex-grow-1 position-relative">
                <div t-if="state.isLoading" class="position-absolute top-50 start-50 translate-middle">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <DagRenderer
                    t-if="!state.isLoading and state.records.length > 0"
                    t-ref="renderer"
                    records="state.records"
                    edgeField="archInfo.edgeField"
                    direction="archInfo.direction"
                    colorField="archInfo.colorField"
                    labelField="archInfo.labelField"
                    onNodeClick.bind="onNodeClick"
                />

                <div t-if="!state.isLoading and state.records.length === 0"
                     class="position-absolute top-50 start-50 translate-middle text-center text-muted">
                    <i class="fa fa-project-diagram fa-3x mb-3 d-block opacity-50"/>
                    <p class="mb-0">No records to display.</p>
                    <p class="small">Try adjusting your filters.</p>
                </div>
            </div>
        </div>
    </t>

    <!-- Renderer: the Cytoscape container -->
    <t t-name="web_dag.DagRenderer" owl="1">
        <div class="o_dag_container w-100 h-100" t-ref="dagContainer"/>
    </t>

</templates>
