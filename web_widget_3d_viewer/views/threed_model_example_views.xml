<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form view with 3D viewer widget -->
    <record id="view_threed_model_example_form" model="ir.ui.view">
        <field name="name">threed.model.example.form</field>
        <field name="model">threed.model.example</field>
        <field name="arch" type="xml">
            <form string="3D Model">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_filename" invisible="1"/>
                            <field name="file_format" readonly="1"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <separator string="3D Preview"/>
                    <field name="model_file" widget="3d_viewer"
                           filename="model_filename"
                           options="{'height': 500, 'grid': true}"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_threed_model_example_list" model="ir.ui.view">
        <field name="name">threed.model.example.list</field>
        <field name="model">threed.model.example</field>
        <field name="arch" type="xml">
            <list string="3D Models">
                <field name="name"/>
                <field name="model_filename"/>
                <field name="file_format"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_threed_model_example" model="ir.actions.act_window">
        <field name="name">3D Models</field>
        <field name="res_model">threed.model.example</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Root menu -->
    <menuitem id="menu_threed_model_root"
              name="3D Viewer"
              web_icon="web_widget_3d_viewer,static/description/icon.png"
              sequence="100"/>

    <menuitem id="menu_threed_model_example"
              name="3D Models"
              parent="menu_threed_model_root"
              action="action_threed_model_example"
              sequence="10"/>

</odoo>
