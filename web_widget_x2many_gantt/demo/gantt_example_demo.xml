    <record id="demo_trial_copd_nda" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_copd"/>
        <field name="name">NDA 申报（NMPA，COPD 适应症）</field>
        <field name="phase_type">nda</field>
        <field name="status">ongoing</field>
        <field name="date_start">2024-01-01</field>
