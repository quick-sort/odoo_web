<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         度普利尤单抗（Dupilumab / Dupixent®）
         人源化 IgG4 单抗，靶向 IL-4Rα，阻断 IL-4 / IL-13 信号通路
         申办方：赛诺菲 + 再生元
         已在中国获批适应症：特应性皮炎（2020）、哮喘（2021）、CRSwNP（2023）
    ══════════════════════════════════════════════════════════════════ -->

    <record id="demo_drug_dupilumab" model="gantt.example.drug">
        <field name="name">度普利尤单抗</field>
        <field name="generic_name">Dupixent®（度普利尤单抗注射液，靶向 IL-4Rα）</field>
        <field name="molecule_type">biologic</field>
        <field name="sponsor">赛诺菲（Sanofi）/ 再生元（Regeneron）</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         TA 1：特应性皮炎（Atopic Dermatitis，AD）
         首个获批适应症，NMPA 于 2020 年 6 月批准
    ══════════════════════════════════════════════════════════════════ -->

    <record id="demo_ta_dup_ad" model="gantt.example.drug.ta">
        <field name="drug_id" ref="demo_drug_dupilumab"/>
        <field name="therapeutic_area">immunology</field>
        <field name="date_start">2016-06-01</field>
        <field name="date_stop">2024-12-31</field>
    </record>

    <record id="demo_trial_ad_p3_solo" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_ad"/>
        <field name="name">III 期 LIBERTY AD SOLO-ASIA（中重度 AD 成人）</field>
        <field name="phase_type">phase3</field>
        <field name="status">completed</field>
        <field name="date_start">2016-06-01</field>
        <field name="date_stop">2018-09-30</field>
        <field name="regulatory_body">multi</field>
        <field name="site_count">28</field>
        <field name="subject_count">483</field>
        <field name="pi">郑捷</field>
        <field name="notes">主要终点 IGA 0/1 达成，支持 NMPA NDA 申报。</field>
    </record>

    <record id="demo_trial_ad_p3_ped" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_ad"/>
        <field name="name">III 期 LIBERTY AD PEDS（青少年 12–17 岁）</field>
        <field name="phase_type">phase3</field>
        <field name="status">completed</field>
        <field name="date_start">2018-01-01</field>
        <field name="date_stop">2020-06-30</field>
        <field name="regulatory_body">multi</field>
        <field name="site_count">15</field>
        <field name="subject_count">251</field>
        <field name="pi">马琳</field>
    </record>

    <record id="demo_trial_ad_nda" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_ad"/>
        <field name="name">NDA 申报 + NMPA 技术审评（AD 适应症）</field>
        <field name="phase_type">nda</field>
        <field name="status">completed</field>
        <field name="date_start">2019-07-01</field>
        <field name="date_stop">2020-06-30</field>
        <field name="regulatory_body">nmpa</field>
        <field name="pi">李静</field>
        <field name="notes">2020-06-19 获 NMPA 批准上市，首个生物制剂用于中重度 AD。</field>
    </record>

    <record id="demo_trial_ad_p4" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_ad"/>
        <field name="name">IV 期上市后研究（中国真实世界 RWS）</field>
        <field name="phase_type">phase4</field>
        <field name="status">ongoing</field>
        <field name="date_start">2021-01-01</field>
        <field name="date_stop">2024-12-31</field>
        <field name="regulatory_body">nmpa</field>
        <field name="site_count">40</field>
        <field name="subject_count">2000</field>
        <field name="pi">陈旭</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         TA 2：哮喘（Asthma，嗜酸性粒细胞型 + 口服激素依赖型）
         NMPA 于 2021 年 8 月批准
    ══════════════════════════════════════════════════════════════════ -->

    <record id="demo_ta_dup_asthma" model="gantt.example.drug.ta">
        <field name="drug_id" ref="demo_drug_dupilumab"/>
        <field name="therapeutic_area">respiratory</field>
        <field name="date_start">2017-03-01</field>
        <field name="date_stop">2023-12-31</field>
    </record>

    <record id="demo_trial_asthma_p3_quest" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_asthma"/>
        <field name="name">III 期 LIBERTY ASTHMA QUEST（亚太区含中国）</field>
        <field name="phase_type">phase3</field>
        <field name="status">completed</field>
        <field name="date_start">2017-03-01</field>
