        <field name="site_count">32</field>
        <field name="subject_count">1902</field>
        <field name="pi">沈华浩</field>
        <field name="notes">主要终点：严重急性加重年化率降低 67.4%（嗜酸粒细胞 ≥300 亚组）。</field>
    </record>

    <record id="demo_trial_asthma_p3_venture" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_asthma"/>
        <field name="name">III 期 LIBERTY ASTHMA VENTURE（OCS 依赖型）</field>
        <field name="phase_type">phase3</field>
        <field name="status">completed</field>
        <field name="date_start">2018-01-01</field>
        <field name="date_stop">2020-06-30</field>
        <field name="regulatory_body">multi</field>
        <field name="site_count">18</field>
        <field name="subject_count">210</field>
        <field name="pi">沈华浩</field>
    </record>

    <record id="demo_trial_asthma_nda" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_asthma"/>
        <field name="name">NDA 申报 + NMPA 技术审评（哮喘适应症）</field>
        <field name="phase_type">nda</field>
        <field name="status">completed</field>
        <field name="date_start">2020-07-01</field>
        <field name="date_stop">2021-08-31</field>
        <field name="regulatory_body">nmpa</field>
        <field name="pi">李静</field>
        <field name="notes">2021-08-10 NMPA 批准，适用于 12 岁以上中重度嗜酸性粒细胞型哮喘。</field>
    </record>

    <record id="demo_trial_asthma_p4" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_asthma"/>
        <field name="name">IV 期上市后研究（哮喘长期安全性）</field>
        <field name="phase_type">phase4</field>
        <field name="status">ongoing</field>
        <field name="date_start">2022-01-01</field>
        <field name="date_stop">2023-12-31</field>
        <field name="regulatory_body">nmpa</field>
        <field name="site_count">25</field>
        <field name="subject_count">500</field>
        <field name="pi">王刚</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         TA 3：慢性鼻窦炎伴鼻息肉（CRSwNP）
         NMPA 于 2023 年 7 月批准
    ══════════════════════════════════════════════════════════════════ -->

    <record id="demo_ta_dup_crsnp" model="gantt.example.drug.ta">
        <field name="drug_id" ref="demo_drug_dupilumab"/>
        <field name="therapeutic_area">other</field>
        <field name="date_start">2019-06-01</field>
        <field name="date_stop">2025-06-30</field>
    </record>

    <record id="demo_trial_crsnp_p3_sinus" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_crsnp"/>
