    <record id="demo_ta_dup_copd" model="gantt.example.drug.ta">
        <field name="drug_id" ref="demo_drug_dupilumab"/>
        <field name="therapeutic_area">respiratory</field>
        <field name="date_start">2020-09-01</field>
        <field name="date_stop">2027-12-31</field>
    </record>

    <record id="demo_trial_copd_p3_boreas" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_copd"/>
        <field name="name">III 期 BOREAS（含中国中心，嗜酸粒 ≥300 COPD）</field>
        <field name="phase_type">phase3</field>
        <field name="status">completed</field>
        <field name="date_start">2020-09-01</field>
        <field name="date_stop">2022-12-31</field>
