    </record>

    <record id="demo_trial_crsnp_nda" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_crsnp"/>
        <field name="name">NDA 申报 + NMPA 技术审评（CRSwNP）</field>
        <field name="phase_type">nda</field>
        <field name="status">completed</field>
        <field name="date_start">2022-04-01</field>
        <field name="date_stop">2023-07-31</field>
        <field name="regulatory_body">nmpa</field>
        <field name="pi">李静</field>
        <field name="notes">2023-07 NMPA 批准，成为中国首个获批用于 CRSwNP 的生物制剂。</field>
    </record>

    <record id="demo_trial_crsnp_p4" model="gantt.example.trial">
        <field name="drug_ta_id" ref="demo_ta_dup_crsnp"/>
        <field name="name">IV 期上市后安全性观察（CRSwNP）</field>
        <field name="phase_type">phase4</field>
        <field name="status">ongoing</field>
        <field name="date_start">2023-10-01</field>
